<% filters = capture do %>
  <div class="col-md-2"><%= select_tag :provider_id, options_from_collection_for_select(@providers, :id, :name, params[:provider_id]), include_blank: "Todo proveedor", class: "form-select form-select-sm" %></div>
  <div class="col-md-2"><%= select_tag :status, options_for_select([["Sin costo", "no_cost"], ["Sin vínculos", "no_links"]], params[:status]), include_blank: "Cualquier estado", class: "form-select form-select-sm" %></div>
<% end %>
<%= render layout: "shared/index", locals: {title: "Piezas de proveedor", subtitle: "Lo que se compra a cada proveedor, con su código y costo, y dónde se usa.", model: SupplierItem, new_path: new_supplier_item_path, new_label: "Nueva pieza", filters: filters} do %>
  <table class="table table-hover align-middle mb-0 small">
    <thead class="bg-light"><tr><th class="ps-3">Proveedor</th><th>Pieza</th><th>Código</th><th>Unidad</th><th class="text-end">Costo</th><th class="text-center">Vínculos</th><th>Revisión</th></tr></thead>
    <tbody>
      <% @supplier_items.each do |i| %>
        <tr class="<%= "text-muted" unless i.active %>">
          <td class="ps-3"><%= i.provider.name %></td>
          <td><%= link_to i.name, supplier_item_path(i), class: "fw-bold text-decoration-none" %></td>
          <td><code><%= i.sku.presence || "—" %></code></td>
          <td><%= i.unit %></td>
          <td class="text-end"><%= i.default_cost ? number_to_currency(i.default_cost, unit: "₡") : content_tag(:span, "Sin costo", class: "badge bg-danger bg-opacity-10 text-danger") %></td>
          <td class="text-center"><%= i.supplier_links.size.zero? ? content_tag(:span, "0", class: "badge bg-warning bg-opacity-25 text-warning") : i.supplier_links.size %></td>
          <td><%= render "reviews/badge", record: i %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
