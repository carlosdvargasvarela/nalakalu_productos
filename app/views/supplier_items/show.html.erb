<%= render "reviews/bar", record: @supplier_item, back_path: supplier_items_path, back_label: "Piezas de proveedor", edit_path: edit_supplier_item_path(@supplier_item) %>
<div class="container py-4" style="max-width: 960px;">
  <div class="mb-3">
    <h2 class="fw-bold mb-1"><%= @supplier_item.name %></h2>
    <span class="text-muted"><i class="bi bi-building me-1"></i><%= link_to @supplier_item.provider.name, provider_path(@supplier_item.provider) %></span>
    <span class="badge bg-<%= @supplier_item.active ? "success" : "secondary" %> ms-2"><%= @supplier_item.active ? "Activa" : "Inactiva" %></span>
  </div>
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body row g-3">
      <div class="col-md-4"><div class="small text-muted">Código del proveedor</div><code><%= @supplier_item.sku.presence || "—" %></code></div>
      <div class="col-md-4"><div class="small text-muted">Unidad</div><%= @supplier_item.unit %></div>
      <div class="col-md-4"><div class="small text-muted">Costo</div>
        <%= @supplier_item.default_cost ? number_to_currency(@supplier_item.default_cost, unit: "₡", format: "%u%n") : content_tag(:span, "Sin costo", class: "badge bg-danger bg-opacity-10 text-danger") %></div>
    </div>
  </div>
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white">
      <h5 class="fw-bold mb-0"><i class="bi bi-link-45deg me-1"></i>Dónde se usa</h5>
      <div class="small text-muted">
        <b>Solo variante</b>: la variante se compra con este código en cualquier producto (ej: un textil).
        <b>Producto + variante</b>: depende de ambos (ej: sobre en fibra F1 de esta mesa).
        <b>Solo producto</b>: es del producto sin importar la variante.
      </div>
    </div>
    <% links = @supplier_item.supplier_links.includes(:product, variant: :variant_type).sort_by { [_1.kind.to_s, _1.label] } %>
    <% if links.empty? %>
      <div class="card-body text-muted fst-italic">Todavía no está vinculada a nada.</div>
    <% else %>
      <ul class="list-group list-group-flush">
        <% links.each do |l| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
              <span class="badge bg-<%= {variant: "info", product_variant: "primary", product: "secondary"}[l.kind] %> me-2"><%= {variant: "Solo variante", product_variant: "Producto + variante", product: "Solo producto"}[l.kind] %></span>
              <%= l.product ? link_to(l.product.name, product_path(l.product)) : nil %>
              <%= " · " if l.product && l.variant %>
              <%= l.variant ? link_to("#{l.variant.variant_type.name} → #{l.variant.seller_name}", variant_path(l.variant)) : nil %>
            </span>
            <%= button_to supplier_link_path(l), method: :delete, class: "btn btn-sm btn-outline-danger", form: {data: {turbo_confirm: "¿Quitar este vínculo?"}} do %><i class="bi bi-x-lg"></i><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <div class="card-body border-top bg-light">
      <%= form_with model: SupplierLink.new(supplier_item: @supplier_item), class: "row g-2 align-items-end" do |f| %>
        <%= f.hidden_field :supplier_item_id %>
        <div class="col-md-5"><%= f.label :product_id, "Producto (opcional)", class: "form-label small fw-bold mb-1" %>
          <%= f.collection_select :product_id, Product.order(:name), :id, ->(p) { "#{p.name} (#{p.base_code})" }, {include_blank: "— cualquiera —"}, class: "form-select form-select-sm" %></div>
        <div class="col-md-5"><%= f.label :variant_id, "Variante (opcional)", class: "form-label small fw-bold mb-1" %>
          <%= f.select :variant_id, Variant.joins(:variant_type).includes(:variant_type).order("variant_types.name", "variants.name").map { ["#{_1.variant_type.name} → #{_1.seller_name}", _1.id] }, {include_blank: "— ninguna —"}, class: "form-select form-select-sm" %></div>
        <div class="col-md-2"><%= f.submit "Agregar vínculo", class: "btn btn-sm btn-primary w-100" %></div>
      <% end %>
    </div>
  </div>
  <div class="card border-0 shadow-sm rounded-4 mt-4">
    <div class="card-header bg-white">
      <h5 class="fw-bold mb-0"><i class="bi bi-copy me-1"></i>Duplicar para variantes</h5>
      <div class="small text-muted">
        Si esta pieza cambia según la variante (ej: el mismo sobre en piedra A, B o C), crea una copia por variante.
        Cada copia queda vinculada <%= @supplier_item.products.any? ? "a #{@supplier_item.products.map(&:name).to_sentence} + " : "a " %>esa variante, con el código vacío para que lo completes.
      </div>
    </div>
    <div class="card-body bg-light">
      <%= form_with url: duplicate_supplier_item_path(@supplier_item), class: "row g-2 align-items-end" do |f| %>
        <div class="col-md-9"><%= f.select :variant_ids, Variant.joins(:variant_type).includes(:variant_type).order("variant_types.name", "variants.name").map { ["#{_1.variant_type.name} → #{_1.seller_name}", _1.id] }, {}, multiple: true, class: "form-select form-select-sm" %></div>
        <div class="col-md-3 d-flex gap-2"><%= f.submit "Duplicar", class: "btn btn-sm btn-primary flex-fill" %>
          <%= f.submit "Copia simple", name: "plain", class: "btn btn-sm btn-outline-secondary flex-fill", title: "Una sola copia, sin variantes" %></div>
      <% end %>
    </div>
  </div>
</div>
