<%= form_with(model: supplier_item) do |f| %>
  <% if supplier_item.errors.any? %>
    <div class="alert alert-danger"><%= supplier_item.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="row g-3">
    <div class="col-md-6"><%= f.label :provider_id, "Proveedor", class: "form-label small fw-bold" %>
      <%= f.collection_select :provider_id, Provider.order(:name), :id, :name, {}, class: "form-select" %></div>
    <div class="col-md-6"><%= f.label :name, "Nombre de la pieza", class: "form-label small fw-bold" %>
      <%= f.text_field :name, class: "form-control" %></div>
    <div class="col-md-4"><%= f.label :sku, "Código del proveedor", class: "form-label small fw-bold" %>
      <%= f.text_field :sku, class: "form-control font-monospace" %></div>
    <div class="col-md-4"><%= f.label :unit, "Unidad", class: "form-label small fw-bold" %>
      <%= f.select :unit, SupplierItem::UNITS, {}, class: "form-select" %></div>
    <div class="col-md-4"><%= f.label :default_cost, "Costo (₡)", class: "form-label small fw-bold" %>
      <%= f.number_field :default_cost, step: "0.01", min: 0, class: "form-control", placeholder: "Sin costo" %></div>
    <div class="col-12 form-check ms-2"><%= f.check_box :active, class: "form-check-input" %> <%= f.label :active, "Activo", class: "form-check-label" %></div>
  </div>
  <div class="mt-4 d-flex gap-2">
    <%= f.submit "Guardar", class: "btn btn-primary rounded-pill px-4" %>
    <%= link_to "Cancelar", form_back(supplier_item.persisted? ? supplier_item_path(supplier_item) : supplier_items_path), class: "btn btn-light rounded-pill px-4" %>
  </div>
<% end %>
