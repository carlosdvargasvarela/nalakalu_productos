<div class="container-fluid px-4 py-4 pb-5" style="max-width: 1100px;" <%= tag.attributes(data: (@bulk_kind && @reviews.any? ? {controller: "bulk-actions", bulk_actions_all_ids_value: @all_ids.to_json} : {})) %>>
  <h1 class="h3 fw-bold mb-1">Por corregir</h1>
  <p class="text-muted small">Registros que un revisor marcó como «requiere cambios». Al corregirlos y aprobarlos desaparecen de aquí.</p>
  <div class="d-flex flex-wrap gap-2 mb-3">
    <%= link_to "Todos", reviews_path, class: "btn btn-sm #{params[:type].blank? ? "btn-dark" : "btn-outline-secondary"}" %>
    <% Reviewable::MODELS.each do |t| %>
      <%= link_to t.constantize.model_name.human(count: 2), reviews_path(type: t), class: "btn btn-sm #{params[:type] == t ? "btn-dark" : "btn-outline-secondary"}" %>
    <% end %>
  </div>
  <% if @bulk_kind.nil? && @reviews.any? %>
    <p class="small text-muted"><i class="bi bi-info-circle"></i> Para aprobar, devolver a pendiente, ocultar o eliminar varios a la vez, elige arriba un tipo (Productos, Variantes…).</p>
  <% end %>
  <% if @reviews.empty? %>
    <p class="text-success"><i class="bi bi-check-circle"></i> No hay nada por corregir.</p>
  <% else %>
    <div class="card border-0 shadow-sm rounded-4"><div class="table-responsive">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="bg-light"><tr><% if @bulk_kind %><th class="ps-3" style="width: 34px;"><%= bulk_check_all %></th><% end %><th class="ps-3">Tipo</th><th>Registro</th><th>Comentario</th><th>Revisor</th><th>Cuándo</th></tr></thead>
        <tbody>
          <% @reviews.each do |r| %>
            <% rec = r.reviewable %>
            <tr>
              <% if @bulk_kind %><td class="ps-3"><%= bulk_check(rec) %></td><% end %>
              <td class="ps-3"><%= r.reviewable_type.constantize.model_name.human %></td>
              <td><%= link_to record_title(rec), polymorphic_path(rec), class: "fw-bold text-decoration-none" %></td>
              <td><%= r.note %></td>
              <td><%= r.user&.email&.split("@")&.first %></td>
              <td class="text-muted"><%= l r.updated_at.in_time_zone("Central America"), format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div></div>
    <%= render "shared/bulk_bar", kind: @bulk_kind, all_ids: @all_ids if @bulk_kind %>
  <% end %>
</div>
