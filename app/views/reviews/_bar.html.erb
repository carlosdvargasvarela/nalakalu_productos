<%# Barra superior de navegación. locals: record, back_path, back_label, edit_path, dup_path?, dup_post? %>
<div class="bg-white border-bottom shadow-sm" style="position: sticky; top: 56px; z-index: 1020;">
  <div class="container-fluid px-4 py-2 d-flex flex-wrap align-items-center gap-2">
    <%= link_to back_path, class: "btn btn-sm btn-light" do %><i class="bi bi-arrow-left"></i> <%= back_label %><% end %>
    <span class="fw-bold text-truncate" style="max-width: 420px;"><%= record_title(record) %></span>
    <span class="flex-grow-1"></span>
    <%= link_to prev_review_path(type: record.class.name, before: record.id), class: "btn btn-sm btn-outline-secondary", title: "Registro anterior de la lista (tecla P)", data: {review_panel_target: "prev"} do %><i class="bi bi-arrow-left"></i> Anterior<% end %>
    <%= link_to next_review_path(type: record.class.name, after: record.id), class: "btn btn-sm btn-outline-secondary", title: "Siguiente pendiente, sin cambiar el estado de este (tecla S)", data: {review_panel_target: "skip"} do %>Saltar <i class="bi bi-arrow-right"></i><% end %>
    <span class="vr mx-1"></span>
    <%= link_to changes_path(type: record.class.name, id: record.id), class: "btn btn-sm btn-outline-secondary", title: "Historial de este registro" do %><i class="bi bi-clock-history"></i><% end %>
    <% if local_assigns[:dup_path] %>
      <% if local_assigns[:dup_post] %>
        <%= button_to dup_path, method: :post, class: "btn btn-sm btn-outline-primary", form: {class: "d-inline", data: {turbo_confirm: "¿Crear una copia?"}} do %><i class="bi bi-copy"></i> Duplicar<% end %>
      <% else %>
        <%= link_to dup_path, class: "btn btn-sm btn-outline-primary", title: "Dividir, unir o duplicar" do %><i class="bi bi-diagram-2"></i> Reorganizar<% end %>
      <% end %>
    <% end %>
    <%= link_to edit_path, class: "btn btn-sm btn-primary", title: "Corregir este registro (tecla E)", data: {review_panel_target: "edit"} do %><i class="bi bi-pencil"></i> Editar<% end %>
  </div>
</div>
