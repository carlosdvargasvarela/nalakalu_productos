<% if pending_count > 0 %>
  <div class="px-3 py-2 border-bottom d-flex align-items-center gap-3 small">
    <div class="form-check mb-0">
      <input class="form-check-input" type="checkbox" id="select-all-unresolved"
             data-sync-review-target="selectAllUnresolved"
             data-action="change->sync-review#toggleSelectAll">
      <label class="form-check-label fw-semibold" for="select-all-unresolved">Seleccionar pendientes visibles</label>
    </div>
    <span class="text-muted"><span data-sync-review-target="bulkCount"></span> seleccionado(s)</span>
    <button type="button" class="btn btn-sm btn-outline-primary"
            data-sync-review-target="bulkAssignBtn"
            data-bs-toggle="modal" data-bs-target="#bulkAssignProductModal" disabled>
      <i class="bi bi-box-seam me-1"></i>Asignar producto
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary"
            data-sync-review-target="bulkIgnoreBtn"
            data-action="click->sync-review#submitBulkIgnore"
            data-turbo-confirm="¿Ignorar los movimientos seleccionados?" disabled>
      <i class="bi bi-eye-slash me-1"></i>Ignorar seleccionados
    </button>
    <form id="bulk-ignore-form" action="<%= bulk_ignore_inventory_sync_path(sync) %>" method="post" class="mb-0">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    </form>
    <form id="bulk-assign-product-form" action="<%= bulk_assign_product_inventory_sync_path(sync) %>" method="post" class="mb-0">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    </form>
  </div>
<% end %>
