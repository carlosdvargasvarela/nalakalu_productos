<%= render layout: "shared/index", locals: {title: "Tipos de variante", subtitle: "Los grupos de opciones (Textiles, Maderas, Piedras...).", model: VariantType, new_path: new_variant_type_path, new_label: "Nuevo tipo", hideable: true} do %>
  <table class="table table-hover align-middle mb-0 small">
    <thead class="bg-light"><tr><th class="ps-3">Tipo</th><th class="text-center">Variantes</th><th>¿Código de proveedor propio?</th><th>Revisión</th></tr></thead>
    <tbody>
      <% @variant_types.each do |t| %>
        <tr>
          <td class="ps-3" style="min-width: 280px;"><%= quick_name("variant_type", t, variant_type_path(t)) %><%= content_tag(:span, "Oculto", class: "badge bg-secondary ms-2") unless t.active %></td>
          <td class="text-center"><%= t.variants.size %></td>
          <td><%= t.own_supplier_code ? content_tag(:span, "Sí", class: "badge bg-success bg-opacity-10 text-success") : "No" %></td>
          <td><%= render "reviews/badge", record: t %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
