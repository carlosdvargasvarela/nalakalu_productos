<%= render layout: "reviews/layout", locals: {record: @family, back_path: families_path, back_label: "Familias", edit_path: edit_family_path(@family), dup_path: reorganize_path("family", @family), dup_post: false} do %>
<div>
  <!-- Header -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center">
        <div class="col-md-8">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
              <li class="breadcrumb-item"><%= link_to "Familias", families_path, class: "text-decoration-none" %></li>
              <li class="breadcrumb-item active fw-bold"><%= @family.name %></li>
            </ol>
          </nav>
          <div class="d-flex align-items-center gap-3">
            <div class="bg-info bg-opacity-10 p-3 rounded-3 flex-shrink-0">
              <i class="bi bi-diagram-3 fs-3 text-info"></i>
            </div>
            <div>
              <h2 class="fw-bold mb-0"><%= @family.name %></h2>
              <p class="text-muted mb-0"><%= @family.description %></p>
            </div>
          </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
          <div class="d-flex gap-2 justify-content-md-end">
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row g-4">
    <!-- Estructura de la Familia -->
    <div class="col-lg-5">
      <% fam_rules = @family.family_variant_rules.includes(:variant_type).order(:position).to_a %>
      <% by_type = Variant.where(variant_type_id: fam_rules.map(&:variant_type_id), active: true).order(:name).group_by(&:variant_type_id) %>
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
          <h5 class="mb-0 fw-bold"><i class="bi bi-palette me-2 text-info"></i>Variantes de la familia</h5>
          <% if fam_rules.any? %><div class="small text-muted"><%= pluralize(fam_rules.size, "tipo de variante", plural: "tipos de variante") %> · <%= pluralize(by_type.values.sum(&:size), "variante", plural: "variantes") %></div><% end %>
        </div>
        <div class="card-body p-4">
          <% if fam_rules.any? %>
            <div class="d-flex flex-column gap-3">
              <% fam_rules.each do |rule| %>
                <% vs = by_type[rule.variant_type_id].to_a %>
                <div>
                  <div class="mb-1"><span class="fw-bold"><%= rule.label.presence || rule.variant_type.name %></span>
                    <% if rule.label.present? && rule.label != rule.variant_type.name %><span class="text-muted small">· tipo «<%= rule.variant_type.name %>»</span><% end %>
                    <span class="badge bg-light text-dark border rounded-pill ms-1"><%= vs.size %></span></div>
                  <% if vs.any? %>
                    <div class="d-flex flex-wrap gap-1">
                      <% vs.first(24).each do |v| %><%= link_to v.seller_name, variant_path(v), class: "badge bg-light text-dark border rounded-pill px-2 py-1 fw-normal text-decoration-none" %><% end %>
                    </div>
                    <% if vs.size > 24 %>
                      <details class="small mt-1"><summary class="text-primary" style="cursor: pointer;">Ver las <%= vs.size - 24 %> restantes</summary>
                        <div class="d-flex flex-wrap gap-1 mt-1"><% vs.drop(24).each do |v| %><%= link_to v.seller_name, variant_path(v), class: "badge bg-light text-dark border rounded-pill px-2 py-1 fw-normal text-decoration-none" %><% end %></div>
                      </details>
                    <% end %>
                  <% else %>
                    <div class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Este tipo no tiene ninguna variante</div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted small mb-2">Esta familia no tiene variantes asociadas.</p>
            <%= link_to edit_family_path(@family), class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %><i class="bi bi-plus-lg me-1"></i>Asociar tipos de variante<% end %>
          <% end %>
        </div>
      </div>
      <!-- Asignar Productos -->
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom">
          <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-success"></i>Asignar Productos</h5>
        </div>
        <div class="card-body p-4">
          <%= form_with url: assign_products_family_path(@family), method: :post do |f| %>
            <div class="mb-3">
              <label class="form-label small fw-bold text-muted">Selecciona productos sin familia:</label>
              <div class="border rounded-3 p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                <% Product.where(family_id: nil).order(:name).each do |p| %>
                  <div class="form-check mb-2">
                    <%= check_box_tag "product_ids[]", p.id, false, class: "form-check-input", id: "prod_#{p.id}" %>
                    <label class="form-check-label small" for="prod_<%= p.id %>">
                      <%= p.name %> <code class="text-muted ms-1"><%= p.base_code %></code>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
            <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold">
              Asignar y Aplicar Reglas
            </button>
            <div class="form-text x-small mt-2 text-center">
              <i class="bi bi-info-circle me-1"></i>Esto clonará las reglas de la familia a los productos.
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <!-- Productos en esta Familia -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i>Productos Vinculados</h5>
          <span class="badge bg-primary rounded-pill px-3"><%= @family.products.count %></span>
        </div>
        <div class="card-body p-0">
          <% if @family.products.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                  <tr>
                    <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Producto</th>
                    <th class="py-3 text-muted small fw-bold text-uppercase">Código Base</th>
                    <th class="py-3 text-muted small fw-bold text-uppercase text-center">Variantes</th>
                    <th class="py-3 pe-4 text-end text-muted small fw-bold text-uppercase">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% @family.products.order(:name).each do |product| %>
                    <tr>
                      <td class="px-4 py-3">
                        <%= link_to product.name, product, class: "text-decoration-none fw-bold text-dark" %>
                      </td>
                      <td class="py-3"><code><%= product.base_code %></code></td>
                      <td class="py-3 text-center">
                        <% if product.product_variant_rules.any? %>
                          <span class="badge bg-warning-soft text-warning rounded-pill px-2" title="Tiene tipos de variante propios que reemplazan los de la familia">Propias</span>
                        <% else %>
                          <span class="badge bg-info-soft text-info rounded-pill px-2" title="Usa los tipos de variante de la familia">De la familia</span>
                        <% end %>
                      </td>
                      <td class="py-3 pe-4 text-end">
                        <%= button_to unassign_product_family_path(@family, product_id: product.id), method: :delete, class: "btn btn-sm btn-outline-danger border-0 rounded-circle", data: { turbo_confirm: "¿Desvincular #{product.name} de esta familia?" } do %>
                          <i class="bi bi-x-circle"></i>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
              <p>No hay productos asignados a esta familia.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .x-small { font-size: 0.7rem; }
  .bg-warning-soft { background-color: #fff8e6; }
</style>
<% end %>
