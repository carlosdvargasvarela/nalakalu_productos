<% unless user_signed_in? %>
  <div class="text-center py-5">
    <h1 class="display-6 fw-bold">Nalakalú · Revisión de catálogo</h1>
    <p class="lead text-muted">Revisa y corrige los datos antes de subirlos a Odoo.</p>
    <%= link_to "Iniciar sesión", new_user_session_path, class: "btn btn-primary btn-lg" %>
  </div>
<% else %>
  <h1 class="h3 fw-bold mb-1">Progreso de revisión</h1>
  <p class="text-muted">Aprobado = un revisor confirmó que el registro está listo para Odoo.</p>
  <div class="row g-3 mb-4">
    <% @progress.each do |m| %>
      <% pct = m[:total].zero? ? 0 : (m[:approved] * 100.0 / m[:total]).round %>
      <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-baseline">
              <h5 class="fw-bold mb-0"><%= link_to m[:title], m[:path], class: "text-decoration-none" %></h5>
              <span class="text-muted small"><%= m[:total] %> registros</span>
            </div>
            <div class="progress my-3" style="height: 10px;">
              <div class="progress-bar bg-success" style="width: <%= pct %>%"></div>
            </div>
            <div class="small d-flex gap-3 mb-3">
              <span class="text-success"><i class="bi bi-check-circle"></i> <%= m[:approved] %> aprobados</span>
              <span class="text-danger"><i class="bi bi-exclamation-circle"></i> <%= m[:needs_changes] %> con cambios</span>
              <span class="text-muted"><i class="bi bi-hourglass"></i> <%= m[:pending] %> pendientes</span>
            </div>
            <% if m[:pending] > 0 %>
              <%= link_to next_review_path(type: m[:type]), class: "btn btn-sm btn-success" do %><i class="bi bi-play-fill"></i> Empezar a revisar<% end %>
            <% else %>
              <span class="text-success fw-bold small"><i class="bi bi-check-circle-fill"></i> Todo revisado</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to quality_path, class: "btn btn-outline-warning" do %><i class="bi bi-shield-exclamation me-1"></i>Problemas de calidad<% end %>
    <%= link_to odoo_exports_path, class: "btn btn-outline-primary" do %><i class="bi bi-download me-1"></i>CSV para Odoo<% end %>
  </div>
<% end %>
