<% noun = @model.model_name.human(count: 2).downcase %>
<div class="container py-4" style="max-width: 760px;">
  <h1 class="h4 fw-bold mb-1">Eliminar <%= @records.size %> <%= noun %></h1>
  <p class="text-muted">Esto es lo que se verá afectado en total:</p>
  <div class="card border-0 shadow-sm rounded-4 mb-3">
    <ul class="list-group list-group-flush">
      <% @impact.each do |(text, loses), count| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span><%= text %></span>
          <span class="badge rounded-pill bg-<%= count.zero? ? "light text-muted border" : (loses ? "danger" : "warning text-dark") %>"><%= count %></span>
        </li>
      <% end %>
      <% if @impact.empty? %><li class="list-group-item text-muted">Sin dependencias.</li><% end %>
    </ul>
  </div>
  <p class="small text-muted mb-1">Ejemplos de lo que se elimina:</p>
  <ul class="small mb-4"><% @sample.each { |r| %><li><%= record_title(r) %></li><% } %><% if @records.size > @sample.size %><li class="text-muted">…y <%= @records.size - @sample.size %> más</li><% end %></ul>

  <% ids = @records.map(&:id) %>
  <div class="row g-3">
    <div class="col-md-6"><div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-success"><div class="card-body">
      <h6 class="fw-bold">Ocultar (recomendado)</h6>
      <p class="small text-muted">Quedan inactivos y no se borra nada.</p>
      <%= form_with url: bulk_path(@kind), method: :post do %>
        <% ids.each { |i| %><%= hidden_field_tag "ids[]", i, id: nil %><% } %>
        <%= hidden_field_tag :bulk_action, "hide" %>
        <button class="btn btn-success btn-sm"><i class="bi bi-eye-slash"></i> Ocultar <%= @records.size %></button>
      <% end %>
    </div></div></div>
    <div class="col-md-6"><div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-danger"><div class="card-body">
      <h6 class="fw-bold">Eliminar definitivamente</h6>
      <p class="small text-muted">Se borra lo marcado en rojo. Se puede deshacer desde el <%= link_to "Historial", changes_path, target: "_blank" %> mientras no haya cambios posteriores.</p>
      <%= form_with url: bulk_path(@kind), method: :post do %>
        <% ids.each { |i| %><%= hidden_field_tag "ids[]", i, id: nil %><% } %>
        <%= hidden_field_tag :bulk_action, "delete" %>
        <%= hidden_field_tag :confirmed, "1" %>
        <button class="btn btn-danger btn-sm" data-turbo-confirm="¿Eliminar <%= @records.size %> <%= noun %>?"><i class="bi bi-trash"></i> Eliminar <%= @records.size %></button>
      <% end %>
    </div></div></div>
  </div>
  <div class="mt-3"><%= link_to "Cancelar", polymorphic_path(@model), class: "btn btn-light" %></div>
</div>
