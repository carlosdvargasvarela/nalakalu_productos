<% noun = @model.model_name.human(count: 2).downcase %>
<div class="container py-4" style="max-width: 760px;">
  <h1 class="h4 fw-bold mb-1">Unir <%= @records.size %> <%= noun %></h1>
  <p class="text-muted">Todo lo de los demás pasa al que conserves, y los demás quedan <b>ocultos</b> (no se borran).</p>
  <%= form_with url: bulk_path(@kind), method: :post do %>
    <% @records.each { |r| %><%= hidden_field_tag "ids[]", r.id, id: nil %><% } %>
    <%= hidden_field_tag :bulk_action, "merge" %>
    <%= hidden_field_tag :confirmed, "1" %>
    <%= hidden_field_tag :return_to, params[:return_to], id: nil %>
    <div class="card border-0 shadow-sm rounded-4 mb-3">
      <div class="card-header bg-white fw-bold">¿Cuál se conserva?</div>
      <ul class="list-group list-group-flush">
        <% @records.each do |r| %>
          <li class="list-group-item">
            <label class="d-flex align-items-center gap-3 mb-0" style="cursor: pointer;">
              <%= radio_button_tag :target_id, r.id, r == @default_target, class: "form-check-input mt-0" %>
              <span class="flex-grow-1"><b><%= record_title(r) %></b><span class="text-muted small d-block"><%= @stats[r][:text] %></span></span>
            </label>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="mb-3">
      <label class="form-label small fw-bold" for="new_name">Nombre final (opcional)</label>
      <%= text_field_tag :new_name, nil, class: "form-control", style: "max-width: 420px;", placeholder: "Dejar vacío para conservar el nombre del elegido" %>
    </div>
    <% if @warnings.any? %>
      <div class="alert alert-warning small"><% @warnings.each { |w| %><div><i class="bi bi-exclamation-triangle me-1"></i><%= w %></div><% } %></div>
    <% end %>
    <div class="small text-muted mb-3">
      <% case @kind when "family" %>Los productos conservan sus propias variantes; la familia final suma los tipos de variante de todas.
      <% when "variant_type" %>Las variantes pasan al tipo final, y los productos y familias que usaban los otros pasan a usar el final sin perder las variantes que tenían permitidas.
      <% when "provider" %>Las piezas pasan al proveedor final.<% end %>
      Se puede deshacer desde el <%= link_to "Historial", changes_path, target: "_blank" %>.
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary" data-turbo-confirm="¿Unir <%= @records.size %> <%= noun %>?"><i class="bi bi-intersect"></i> Unir</button>
      <%= link_to "Cancelar", return_path, class: "btn btn-light" %>
    </div>
  <% end %>
</div>
