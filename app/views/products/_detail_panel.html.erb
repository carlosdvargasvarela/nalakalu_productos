<div class="card border-0 shadow-sm rounded-4">
  <%# ── HEADER ── %>
  <div class="card-header bg-white border-bottom p-4 rounded-top-4">
    <div class="d-flex justify-content-between align-items-start gap-3">
      <div class="flex-grow-1 min-width-0">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
          <h4 class="fw-bold mb-0 text-truncate"><%= product.name %></h4>
          <span class="badge rounded-pill px-3
            <%= product.active? ? 'bg-success bg-opacity-10 text-success' : 'bg-secondary bg-opacity-10 text-secondary' %>">
            <%= product.active? ? 'Activo' : 'Inactivo' %>
          </span>
          <%= render "reviews/badge", record: product %>
        </div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <code class="text-muted small"><%= product.base_code %></code>
          <% if product.list_price.nil? %>
            <span class="badge bg-danger bg-opacity-10 text-danger">Sin precio</span>
          <% else %>
            <span class="text-muted small"><%= number_to_currency(product.list_price, unit: "₡", format: "%u%n") %></span>
          <% end %>
          <% if product.family.present? %>
            <span class="text-muted small">
              <i class="bi bi-diagram-3 me-1 text-info"></i>
              <span class="text-info fw-bold"><%= product.family.name %></span>
            </span>
          <% end %>
        </div>
      </div>
      <div class="d-flex gap-2 flex-shrink-0">

      </div>
    </div>
  </div>
  <div class="card-body p-0">
    <%# ── DNA ── %>
    <%# ── VARIANTES ASOCIADAS ── %>
    <% rules = product.effective_rules %>
    <div class="p-4 border-top">
      <% if rules.any? %>
        <% per_rule = rules.map { |rule| [rule, product.compatible_variants_for(rule.variant_type).where(active: true).includes(:variant_type).order(:name).to_a] } %>
        <h6 class="fw-bold mb-1"><i class="bi bi-palette me-2 text-info"></i>Variantes asociadas</h6>
        <p class="small text-muted mb-3">Tiene <%= pluralize(rules.size, "tipo de variante", plural: "tipos de variante") %> y <%= pluralize(per_rule.sum { _2.size }, "variante", plural: "variantes") %> en total.</p>
        <div class="d-flex flex-column gap-3">
          <% per_rule.each do |rule, variants| %>
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <span class="fw-bold"><%= rule.label.presence || rule.variant_type.name %></span>
                  <% if rule.label.present? && rule.label != rule.variant_type.name %><span class="text-muted small">· tipo «<%= rule.variant_type.name %>»</span><% end %>
                  <span class="badge bg-light text-dark border rounded-pill ms-1"><%= variants.size %></span>
                </div>
                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" data-bs-toggle="modal" data-bs-target="#modalRule<%= rule.id %>">
                  <i class="bi bi-gear-fill me-1"></i><span class="x-small">Gestionar</span>
                </button>
              </div>
              <% if variants.any? %>
                <% shown, rest = variants.first(30), variants.drop(30) %>
                <div class="d-flex flex-wrap gap-1">
                  <% shown.each do |v| %>
                    <%= link_to (v.display_name.presence || v.name), variant_path(v), class: "badge bg-light text-dark border rounded-pill px-2 py-1 fw-normal text-decoration-none" %>
                  <% end %>
                </div>
                <% if rest.any? %>
                  <details class="mt-1 small"><summary class="text-primary" style="cursor: pointer;">Ver las <%= rest.size %> restantes</summary>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                      <% rest.each do |v| %><%= link_to (v.display_name.presence || v.name), variant_path(v), class: "badge bg-light text-dark border rounded-pill px-2 py-1 fw-normal text-decoration-none" %><% end %>
                    </div>
                  </details>
                <% end %>
              <% else %>
                <div class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Sin ninguna variante asociada</div>
              <% end %>
            </div>
            <%= render "compatibility_modal", product: product, rule: rule %>
          <% end %>
        </div>
      <% else %>
        <h6 class="fw-bold mb-1"><i class="bi bi-palette me-2 text-info"></i>Variantes asociadas</h6>
        <p class="small text-muted mb-2">Este producto no tiene variantes asociadas.</p>
        <%= link_to edit_product_path(product), class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %><i class="bi bi-plus-lg me-1"></i>Asociar variantes<% end %>
      <% end %>
    </div>
    <%# ── PIEZAS DE PROVEEDOR ── %>
    <div class="p-4 border-top bg-light bg-opacity-50 rounded-bottom-4">
      <h6 class="fw-bold mb-3"><i class="bi bi-box-seam me-2 text-success"></i>Piezas de proveedor</h6>
      <% links = product.supplier_links.includes(:variant, supplier_item: :provider).sort_by(&:label) %>
      <% if links.empty? %>
        <p class="small text-muted fst-italic mb-0">Sin piezas relacionadas.</p>
      <% else %>
        <ul class="list-unstyled small mb-0">
          <% links.each do |l| %>
            <% i = l.supplier_item %>
            <li><%= link_to i.name, supplier_item_path(i) %>
              <span class="text-muted">· <%= i.provider.name %> · <%= i.sku.presence || "sin código" %> · <%= i.default_cost ? number_to_currency(i.default_cost, unit: "₡", format: "%u%n") : "sin costo" %></span>
              <% if l.variant %><span class="badge bg-primary bg-opacity-10 text-primary"><%= l.variant.seller_name %></span><% end %></li>
          <% end %>
        </ul>
      <% end %>
      <%= render "supplier_links/piece_suggestions", suggestions: NameMatcher.new.pieces_for_product(product), variant: nil, product: product %>
      <%# Zona peligro %>
      <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
        <span class="x-small text-muted">¿Ya no sirve este producto?</span>
        <%= link_to confirm_delete_path("product", product), class: "btn btn-sm btn-outline-danger rounded-pill px-3", title: "Eliminar" do %><i class="bi bi-trash me-1"></i>Eliminar<% end %>
      </div>
    </div>
  </div>
</div>
<style>
  .x-small { font-size: 0.7rem; }
  .btn-xs { font-size: 0.7rem; padding: 0.15rem 0.5rem; }
  .min-width-0 { min-width: 0; }
  .rounded-top-4 { border-radius: 1rem 1rem 0 0 !important; }
  .rounded-bottom-4 { border-radius: 0 0 1rem 1rem !important; }
</style>