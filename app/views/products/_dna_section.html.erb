<% rules = product.effective_rules %>
<div class="p-4 border-bottom">
  <h6 class="fw-bold mb-1"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Cómo se arma el código de venta</h6>
  <p class="small text-muted">Parte del código base y suma las opciones que se elijan en cada paso (tela, madera…).</p>
  <% if rules.any? %>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="badge bg-dark rounded-pill px-3 fs-6" title="Código base"><%= product.base_code %></span>
      <% rules.each do |rule| %>
        <i class="bi bi-plus text-muted small"></i>
        <span class="badge bg-primary rounded-pill px-3 fs-6 <%= "opacity-75" unless rule.required? %>" title="<%= rule.required? ? "Obligatorio" : "Opcional" %>"><%= rule.label.presence || rule.variant_type.name %></span>
      <% end %>
    </div>
    <div class="bg-light rounded-3 p-3 mb-3">
      <div class="small text-muted fw-bold mb-1">Ejemplo de código generado</div>
      <code class="fs-6 text-dark"><%= product.code_structure_preview %></code>
    </div>
    <ol class="small mb-0 ps-3">
      <% rules.each do |rule| %>
        <li class="mb-1"><b><%= rule.label.presence || rule.variant_type.name %></b>
          <span class="text-muted">· tipo «<%= rule.variant_type.name %>» · <%= rule.required? ? "se debe elegir" : "se puede omitir" %></span></li>
      <% end %>
    </ol>
    <% if product.family.present? && product.product_variant_rules.empty? %>
      <div class="alert alert-info border-0 rounded-3 mt-3 mb-0 py-2 px-3 small"><i class="bi bi-arrow-up-circle me-1"></i>Estructura heredada de la familia <strong><%= product.family.name %></strong>.</div>
    <% end %>
  <% else %>
    <div class="text-center py-3 text-muted">
      <p class="small mb-2">Este producto no tiene opciones que elegir: su código es solo el código base.<br>Si debería tenerlas (telas, maderas…), defínelas.</p>
      <%= link_to edit_product_path(product), class: "btn btn-sm btn-outline-primary rounded-pill px-4" do %><i class="bi bi-plus-lg me-1"></i>Definir las opciones<% end %>
    </div>
  <% end %>
</div>
