<%
  items = [
    ["Familias", families_path, "bi-collection", "families", Family],
    ["Productos", products_path, "bi-box", "products", Product],
    ["Tipos de variante", variant_types_path, "bi-tags", "variant_types", VariantType],
    ["Variantes", variants_path, "bi-palette", "variants", Variant],
    ["Proveedores", providers_path, "bi-building", "providers", Provider],
    ["Piezas", supplier_items_path, "bi-box-seam", "supplier_items", SupplierItem]
  ]
%>
<% items.each do |label, path, icon, ctrl, model| %>
  <li class="nav-item">
    <%= link_to path, class: "nav-link d-flex align-items-center gap-2 #{'active' if controller_name == ctrl}" do %>
      <i class="bi <%= icon %>"></i><span><%= label %></span>
      <span class="badge bg-secondary small"><%= model.count %></span>
    <% end %>
  </li>
<% end %>
<li class="nav-item dropdown">
  <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
    <i class="bi bi-clipboard-check me-1"></i>Revisión
  </a>
  <ul class="dropdown-menu dropdown-menu-dark border-0 shadow-lg">
    <li><%= link_to root_path, class: "dropdown-item" do %><i class="bi bi-speedometer2 me-2"></i>Progreso<% end %></li>
    <li><%= link_to quality_path, class: "dropdown-item" do %><i class="bi bi-shield-exclamation me-2"></i>Problemas de calidad<% end %></li>
    <li><%= link_to odoo_exports_path, class: "dropdown-item" do %><i class="bi bi-download me-2"></i>CSV para Odoo<% end %></li>
    <% if current_user.admin? %>
      <li><hr class="dropdown-divider opacity-25"></li>
      <li><%= link_to users_path, class: "dropdown-item" do %><i class="bi bi-people me-2"></i>Usuarios<% end %></li>
      <li><%= link_to "/sidekiq", class: "dropdown-item", target: "_blank" do %><i class="bi bi-activity me-2"></i>Sidekiq<% end %></li>
    <% end %>
  </ul>
</li>
